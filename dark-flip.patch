+// ---- what is read --------------------------------------------------------------------------
+// The skater context's words the dark pop and grab work read (+0x13c4 jump, +0x13c8 landing stage,
+// +0x13d0 graph signals, +0x13d4 / +0x13d8 / +0x13dc requests, +0x1414 physics state).
+constexpr std::uintptr_t context_first = 0x1380;
+constexpr std::size_t context_words = 48; // to +0x143c
+constexpr std::size_t trick_bytes = 0x200;  // the core's trick state (core +0x3b8), from its start
+constexpr std::uintptr_t trick_anim_output = 0x38; // trick state -> its animation output (+0x87, +0x8d, +0x9e: the bail exports)
+constexpr std::size_t anim_output_bytes = 0x100;
+// A body's transform rows start at +0x20 (x axis), the up axis at +0x30 (y at +0x34: the dark pop's
+// dark test), spin at +0x90.
+constexpr std::uintptr_t body_up_offset = 0x30;
+// The skater's animation game states (Animation/Dingo/Bool.Intent.*, Float.Anim.*...): pages of
+// values hanging off its AntDrivenComponent (Extension/Trainer/trainer_gamestate.cpp, game build
+// 20260929). A state object holds its name (char*) at +0x18 and its handle at +0x28: the low 12 bits
+// pick the page, the next 11 the value's byte in that page; the page's own bit map is at +0x71c.
+constexpr std::uintptr_t ant_driven_vtable = 0x63aaee8, states_block_vtable = 0x61a8bd8;
+constexpr std::uintptr_t component_collection = 0x70, collection_count = 0x8, collection_first = 0x20, collection_step = 0x20;
+constexpr std::uintptr_t driven_animatable = 0x68, block_pages = 0x60;
+constexpr std::uintptr_t block_ways[2][2]{{0xe8, 0x8}, {0x1d8, 0x248}};
+constexpr std::uintptr_t object_name = 0x18, object_handle = 0x28;
+constexpr std::size_t page_count = 16, page_bytes = 0x71c;
+constexpr std::size_t page_words = (page_bytes + 3) / 4;
+constexpr std::size_t max_changes = 800; // words per step; a step with more is cut and says so
+
+constexpr std::size_t pre_rows = 20, post_rows = 30;
+constexpr std::size_t queue_limit = 30000;
+// XInput button bits.
+constexpr std::uint16_t pad_up = 0x0001, pad_down = 0x0002, pad_left = 0x0004, pad_right = 0x0008;
+constexpr std::uint16_t pad_a = 0x1000, pad_b = 0x2000, pad_x = 0x4000, pad_y = 0x8000, pad_lb = 0x0100, pad_rb = 0x0200;
+constexpr std::uint8_t trigger_down = 102; // of 255
+constexpr float dark_dot = -0.3f;          // board up . skeleton up below this: standing on the board's underside
+
+struct Pad {
+    overlay::GamepadValues values;
+    unsigned user{};
+    std::int64_t qpc{};
+};
+struct Change {
+    std::uint8_t page{};
+    std::uint16_t word{}; // byte offset in the page, a multiple of 4
+    std::uint32_t before{}, after{};
+};
+struct Row {
+    std::int64_t qpc{};
+    std::uint32_t seq{}, state{}, mark{};
+    char phase{}; // 'p' before takeoff, 'a' in the air, 'l' after landing
+    float seconds{};
+    bool wipeout{};
+    Pad pad;
+    bool context_ok{}, board_ok{}, rig_ok{}, trick_ok{}, output_ok{}, pages_ok{};
+    std::array<std::uint32_t, context_words> context{};
+    std::array<float, 3> board_up{}, board_spin{}, rig_up{}, rig_spin{};
+    std::array<std::uint8_t, trick_bytes> trick{};
+    std::array<std::uint8_t, anim_output_bytes> output{};
+    std::vector<Change> changes;
+    std::uint32_t changes_cut{};
+};
+struct AirSummary {
+    std::uint32_t seq{}, steps{}, mark{};
+    std::uint32_t lt_steps{}, rt_steps{}, rb_steps{}, dpad_steps{}, dark_steps{};
+    std::int32_t first_lt{-1}, first_rt{-1}, first_dark{-1}, first_grab_while_dark{-1};
+    std::uint32_t first_state{}, last_state{}, after_state{};
+    float left_y_min{}, left_y_max{}, rig_up_y_min{1}, board_dot_min{1};
+    double seconds{}, body_turn_degrees{};
+    bool wipeout{};
+};
+// state name -> where it is, from the memory search
+struct Named {
+    std::uint16_t place{};
+    std::uint8_t size{}; // bytes: 1 bool, 4 number, 12 vec3, 16 vec4 / quat
+    char kind{};         // 'b' bool, 'f' float, 'i' integer or enum, 'v' vectors, '?'
+    std::string name;
+};
+struct NameMap {
+    std::array<std::vector<Named>, page_count> pages; // sorted by place
+    std::size_t count{}, conflicts{};
+    std::uint64_t ms{};
+};
+
+struct DarkFlip {
+    std::atomic<std::uintptr_t> base{};
+    std::atomic<bool> started{}, probe_on{};
+    // The pad as the game read it (the game's input threads -> the physics thread).
+    SRWLOCK pad_lock = SRWLOCK_INIT;
+    Pad pad;
+    // Physics thread only.
+    std::deque<Row> pre;
+    bool recording{};
+    std::size_t post_left{};
+    std::uint32_t seq{};
+    AirSummary air;
+    bool air_open{};
+    std::uintptr_t block{}, block_entity{};
+    std::uint32_t block_age{};
+    std::array<std::uintptr_t, page_count> page_at{};
+    std::array<std::array<std::uint32_t, page_words>, page_count> page_last{};
+    std::array<bool, page_count> page_known{};
+    std::atomic<std::uint32_t> mark{};
+    std::atomic<bool> scan_wanted{};
+    // Physics thread -> client tick.
+    std::mutex queue_lock;
+    std::vector<Row> rows;
+    std::vector<AirSummary> airs;
+    std::atomic<std::uint64_t> dropped{};
+    std::atomic<std::uint64_t> block_missing{};
+    // The names (scan thread -> client tick).
+    std::mutex names_lock;
+    std::shared_ptr<const NameMap> names;
+    std::atomic<bool> scanning{};
+    // Markers (console -> client tick).
+    std::mutex marks_lock;
+    std::vector<std::string> mark_texts{""};
+    // Client tick only.
+    std::ofstream steps_csv, states_csv;
+    bool csv_failed{};
+    std::int64_t csv_start{};
+    std::string stamp;
+    std::array<std::uint8_t, trick_bytes> last_trick{};
+    std::array<std::uint8_t, anim_output_bytes> last_output{};
+    bool last_trick_ok{}, last_output_ok{};
+};
+DarkFlip& flip() {
+    static auto* value = new DarkFlip; // process lifetime: hooks may call in until exit
+    return *value;
+}
+std::int64_t qpc_now() noexcept {
+    LARGE_INTEGER value{};
+    QueryPerformanceCounter(&value);
+    return value.QuadPart;
+}
+double qpc_seconds(std::int64_t ticks) noexcept {
+    static const double frequency = [] {
+        LARGE_INTEGER value{};
+        QueryPerformanceFrequency(&value);
+        return static_cast<double>(value.QuadPart);
+    }();
+    return static_cast<double>(ticks) / frequency;
+}
+bool air_state(std::uint32_t state) noexcept {
+    // The board air states, and the 600s (board placement / footplants out of the air).
+    return state == sstate::board_air_states[0] || state == sstate::board_air_states[1] || (state >= 600 && state < 700);
+}
+float stick(std::int16_t value) noexcept { return static_cast<float>(value) / 32767.0f; }
+bool sane(float v) noexcept { return std::isfinite(v) && std::abs(v) < 1000; }
+bool pointer(std::uintptr_t value) noexcept { return value > 0x10000 && value < 0x7fffffffffffull && !(value & 3); }
+
+// ---- input side ----------------------------------------------------------------------------
+void observe_pad(unsigned user, overlay::GamepadValues& pad) noexcept {
+    auto& f = flip();
+    const auto now = qpc_now();
+    AcquireSRWLockExclusive(&f.pad_lock);
+    f.pad.values = pad;
+    f.pad.user = user;
+    f.pad.qpc = now;
+    ReleaseSRWLockExclusive(&f.pad_lock);
+}
+
+// ---- physics side --------------------------------------------------------------------------
+// Body 0 of a physics object (the board's root, the skeleton's first ragdoll body): up axis and spin.
+bool root_body(std::uintptr_t physics, std::uintptr_t vtable, std::uint32_t expected, std::array<float, 3>& up, std::array<float, 3>& spin) noexcept {
+    std::uintptr_t type{}, bodies{}, owner{};
+    std::uint32_t count{};
+    if (!pointer(physics) || !memory::peek(physics, type) || type != vtable || !memory::peek(physics + sstate::physics_bodies_offset, bodies) ||
+        !pointer(bodies) || !memory::peek(bodies, count) || count != expected)
+        return false;
+    if (!memory::peek(bodies + sstate::body_owner_offset, owner) || owner != physics || !memory::peek(bodies + body_up_offset, up) ||
+        !memory::peek(bodies + sstate::body_spin_offset, spin))
+        return false;
+    return std::all_of(up.begin(), up.end(), sane) && std::all_of(spin.begin(), spin.end(), sane);
+}
+bool read_bodies(const NoBailSkater& skater, Row& row) noexcept {
+    std::uintptr_t holder{}, board{}, rig_physics{};
+    if (memory::peek(skater.core + sstate::board_holder_offset, holder) && pointer(holder) &&
+        memory::peek(holder + sstate::board_physics_offset, board))
+        row.board_ok = root_body(board, skater.base + sstate::board_physics_vtable, sstate::board_body_count, row.board_up, row.board_spin);
+    if (skater.rig && memory::peek(skater.rig + sstate::rig_physics_offset, rig_physics))
+        row.rig_ok = root_body(rig_physics, skater.base + sstate::rig_physics_vtable, sstate::rig_body_count, row.rig_up, row.rig_spin);
+    return row.board_ok || row.rig_ok;
+}
+std::uintptr_t find_states_block(std::uintptr_t base, std::uintptr_t entity) noexcept {
+    std::uintptr_t collection{}, owner{};
+    std::uint8_t count{};
+    if (!pointer(entity) || !memory::peek(entity + component_collection, collection) || !pointer(collection) ||
+        !memory::peek(collection, owner) || owner != entity || !memory::peek(collection + collection_count, count) || count > 128)
+        return 0;
+    for (unsigned i = 0; i < count; ++i) {
+        std::uintptr_t component{}, type{}, animatable{};
+        if (!memory::peek(collection + collection_first + i * collection_step, component) || !pointer(component) ||
+            !memory::peek(component, type) || type != base + ant_driven_vtable)
+            continue;
+        if (!memory::peek(component + driven_animatable, animatable) || !pointer(animatable)) return 0;
+        for (const auto& way : block_ways) {
+            std::uintptr_t holder{}, block{};
+            if (memory::peek(animatable + way[0], holder) && pointer(holder) && memory::peek(holder + way[1], block) && pointer(block) &&
+                memory::peek(block, type) && type == base + states_block_vtable)
+                return block;
+        }
+        return 0;
+    }
+    return 0;
+}
+// The skater's state pages against the step before: every changed word.
+void diff_pages(DarkFlip& f, const NoBailSkater& skater, Row& row) noexcept {
+    std::uintptr_t type{};
+    const bool block_good = f.block && f.block_entity == skater.entity && memory::peek(f.block, type) && type == skater.base + states_block_vtable;
+    if (!block_good || ++f.block_age > 600) {
+        f.block_age = 0;
+        const auto block = find_states_block(skater.base, skater.entity);
+        if (block != f.block) f.page_known.fill(false);
+        f.block = block;
+        f.block_entity = skater.entity;
+    }
+    if (!f.block) {
+        f.block_missing.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    row.pages_ok = true;
+    std::array<std::uint32_t, page_words> now{};
+    for (std::size_t p = 0; p < page_count; ++p) {
+        std::uintptr_t page{};
+        if (!memory::peek(f.block + block_pages + p * 8, page) || !pointer(page) || !memory::peek_bytes(page, now.data(), page_bytes)) {
+            f.page_known[p] = false;
+            continue;
+        }
+        if (!f.page_known[p] || f.page_at[p] != page) {
+            f.page_at[p] = page;
+            f.page_last[p] = now;
+            f.page_known[p] = true;
+            continue;
+        }
+        auto& last = f.page_last[p];
+        for (std::size_t w = 0; w < page_words; ++w) {
+            if (now[w] == last[w]) continue;
+            if (row.changes.size() < max_changes)
+                row.changes.push_back({static_cast<std::uint8_t>(p), static_cast<std::uint16_t>(w * 4), last[w], now[w]});
+            else
+                ++row.changes_cut;
+            last[w] = now[w];
+        }
+    }
+}
+void tally(AirSummary& a, const Row& row) noexcept {
+    const auto& p = row.pad.values;
+    const auto step = static_cast<std::int32_t>(a.steps);
+    ++a.steps;
+    a.seconds += row.seconds;
+    a.last_state = row.state;
+    a.wipeout |= row.wipeout;
+    const bool lt = p.left_trigger >= trigger_down, rt = p.right_trigger >= trigger_down;
+    if (lt) { ++a.lt_steps; if (a.first_lt < 0) a.first_lt = step; }
+    if (rt) { ++a.rt_steps; if (a.first_rt < 0) a.first_rt = step; }
+    if (p.buttons & pad_rb) ++a.rb_steps;
+    if (p.buttons & (pad_up | pad_down | pad_left | pad_right)) ++a.dpad_steps;
+    const float ly = stick(p.left_y);
+    a.left_y_min = std::min(a.left_y_min, ly);
+    a.left_y_max = std::max(a.left_y_max, ly);
+    if (row.rig_ok) {
+        a.rig_up_y_min = std::min(a.rig_up_y_min, row.rig_up[1]);
+        const float spin = std::sqrt(row.rig_spin[0] * row.rig_spin[0] + row.rig_spin[1] * row.rig_spin[1] + row.rig_spin[2] * row.rig_spin[2]);
+        a.body_turn_degrees += spin * row.seconds * 57.29578;
+    }
+    if (row.board_ok && row.rig_ok) {
+        const float dot = row.board_up[0] * row.rig_up[0] + row.board_up[1] * row.rig_up[1] + row.board_up[2] * row.rig_up[2];
+        a.board_dot_min = std::min(a.board_dot_min, dot);
+        if (dot < dark_dot) {
+            ++a.dark_steps;
+            if (a.first_dark < 0) a.first_dark = step;
+            if ((lt || rt) && a.first_grab_while_dark < 0) a.first_grab_while_dark = step;
+        }
+    }
+}
+void push(DarkFlip& f, Row&& row) {
+    std::lock_guard lock(f.queue_lock);
+    if (f.rows.size() >= queue_limit) {
+        f.dropped.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    f.rows.push_back(std::move(row));
+}
+// Physics thread, every step of the local skater.
+void on_step(const NoBailSkater& skater, float seconds, bool wipeout) noexcept {
+    auto& f = flip();
+    if (!f.probe_on.load(std::memory_order_acquire)) return;
+    try {
+        Row row;
+        row.qpc = qpc_now();
+        row.seconds = seconds;
+        row.wipeout = wipeout;
+        row.mark = f.mark.load(std::memory_order_relaxed);
+        if (!memory::peek(skater.context + sstate::physics_state_offset, row.state)) return;
+        AcquireSRWLockShared(&f.pad_lock);
+        row.pad = f.pad;
+        ReleaseSRWLockShared(&f.pad_lock);
+        row.context_ok = memory::peek(skater.context + context_first, row.context);
+        read_bodies(skater, row);
+        std::uintptr_t trick{}, output{};
+        row.trick_ok = memory::peek(skater.core + sstate::trick_state_offset, trick) && pointer(trick) && memory::peek(trick, row.trick);
+        row.output_ok = row.trick_ok && memory::peek(trick + trick_anim_output, output) && pointer(output) && memory::peek(output, row.output);
+        diff_pages(f, skater, row);
+        const bool air = air_state(row.state);
+        if (air && !f.recording) {
+            // Takeoff: a new air, with the steps just before it.
+            f.recording = true;
+            f.post_left = post_rows;
+            row.seq = ++f.seq;
+            for (auto& before : f.pre) {
+                before.seq = row.seq;
+                before.phase = 'p';
+                push(f, std::move(before));
+            }
+            f.pre.clear();
+            f.air = {};
+            f.air.seq = row.seq;
+            f.air.mark = row.mark;
+            f.air.first_state = row.state;
+            f.air_open = true;
+            f.scan_wanted.store(true, std::memory_order_relaxed);
+        }
+        if (f.recording) {
+            row.seq = f.seq;
+            if (air) {
+                row.phase = 'a';
+                f.post_left = post_rows; // back in the air (a footplant into 201): the air goes on
+                tally(f.air, row);
+            } else {
+                row.phase = 'l';
+                if (f.air_open) {
+                    f.air.after_state = row.state;
+                    f.air.wipeout |= row.wipeout;
+                    f.air_open = false;
+                    std::lock_guard lock(f.queue_lock);
+                    if (f.airs.size() < 256) f.airs.push_back(f.air);
+                }
+                if (f.post_left) --f.post_left;
+                if (!f.post_left) f.recording = false;
+            }
+            push(f, std::move(row));
+        } else {
+            row.phase = 'p';
+            f.pre.push_back(std::move(row));
+            while (f.pre.size() > pre_rows) f.pre.pop_front();
+        }
+    } catch (...) {
+    }
+}
+
+// ---- the names: a search of the game's memory ------------------------------------------------
+char kind_of(std::string_view name, std::uint8_t& size) noexcept {
+    constexpr std::string_view prefix = "Animation/Dingo/";
+    auto rest = name.substr(prefix.size());
+    if (rest.starts_with("Bool.")) { size = 1; return 'b'; }
+    if (rest.starts_with("Float.")) { size = 4; return 'f'; }
+    if (rest.starts_with("Int") || rest.starts_with("Uint") || rest.starts_with("Enum")) { size = 4; return 'i'; }
+    if (rest.starts_with("Vec3.")) { size = 12; return 'v'; }
+    if (rest.starts_with("Vec4.") || rest.starts_with("Quat")) { size = 16; return 'v'; }
+    size = 4;
+    return '?';
+}
+bool readable(DWORD protect) noexcept {
+    if (protect & (PAGE_GUARD | PAGE_NOACCESS)) return false;
+    const DWORD p = protect & 0xff;
+    return p == PAGE_READONLY || p == PAGE_READWRITE || p == PAGE_WRITECOPY || p == PAGE_EXECUTE_READ || p == PAGE_EXECUTE_READWRITE ||
+           p == PAGE_EXECUTE_WRITECOPY;
+}
+void scan_names(DarkFlip& f) noexcept {
+    const auto began = GetTickCount64();
+    auto map = std::make_shared<NameMap>();
+    try {
+        constexpr std::string_view needle = "Animation/Dingo/";
+        constexpr std::size_t chunk = 4u << 20, back = 0x420;
+        std::vector<char> buffer(chunk + back);
+        std::unordered_map<std::string, std::uint32_t> seen; // name -> handle
+        std::uintptr_t address = 0x10000;
+        MEMORY_BASIC_INFORMATION info{};
+        while (address < memory::highest_user_address && VirtualQuery(reinterpret_cast<const void*>(address), &info, sizeof(info))) {
+            const auto start = reinterpret_cast<std::uintptr_t>(info.BaseAddress);
+            const auto end = start + info.RegionSize;
+            address = end;
+            if (info.State != MEM_COMMIT || !readable(info.Protect) || (info.Type != MEM_PRIVATE && info.Type != MEM_MAPPED)) continue;
+            for (std::uintptr_t at = start; at < end; at += chunk) {
+                const std::uintptr_t from = at > start + back ? at - back : start;
+                const std::size_t size = static_cast<std::size_t>(std::min<std::uintptr_t>(end, at + chunk) - from);
+                if (!memory::peek_bytes(from, buffer.data(), size)) continue;
+                const std::string_view view(buffer.data(), size);
+                for (auto hit = view.find(needle, 0); hit != std::string_view::npos && hit < size; hit = view.find(needle, hit + 1)) {
+                    const std::uintptr_t text = from + hit;
+                    // The name: printable, ended within 200 bytes.
+                    const auto stop = view.find('\0', hit);
+                    if (stop == std::string_view::npos || stop - hit > 200) continue;
+                    const std::string name(view.substr(hit, stop - hit));
+                    if (!std::all_of(name.begin(), name.end(), [](char c) { return c > 32 && c < 127; })) continue;
+                    // The object pointing at it from up to 0x400 bytes before (its +0x18).
+                    for (std::uintptr_t slot = (text - 8) & ~std::uintptr_t{7}; slot + 0x400 >= text && slot >= from + 8; slot -= 8) {
+                        std::uintptr_t value{};
+                        std::memcpy(&value, buffer.data() + (slot - from), 8);
+                        if (value != text) continue;
+                        const auto object = slot - object_name;
+                        std::uint32_t handle{};
+                        if (!memory::peek(object + object_handle, handle) || !(handle >> 24)) continue;
+                        const std::uint32_t page = handle & 0xfff, place = (handle >> 12) & 0x7ff;
+                        if (page >= page_count || place >= page_bytes) continue;
+                        const auto known = seen.find(name);
+                        if (known != seen.end()) {
+                            if (known->second != handle) ++map->conflicts;
+                            break;
+                        }
+                        seen.emplace(name, handle);
+                        Named named;
+                        named.place = static_cast<std::uint16_t>(place);
+                        named.kind = kind_of(name, named.size);
+                        named.name = name.substr(needle.size());
+                        map->pages[page].push_back(std::move(named));
+                        ++map->count;
+                        break;
+                    }
+                }
+            }
+        }
+        for (auto& page : map->pages)
+            std::sort(page.begin(), page.end(), [](const Named& a, const Named& b) { return a.place < b.place; });
+    } catch (...) {
+    }
+    map->ms = GetTickCount64() - began;
+    {
+        std::lock_guard lock(f.names_lock);
+        f.names = map;
+    }
+    f.scanning.store(false, std::memory_order_release);
+}
+void start_scan(DarkFlip& f) {
+    bool expected = false;
+    if (!f.scanning.compare_exchange_strong(expected, true)) return;
+    try {
+        std::thread([&f] { scan_names(f); }).detach();
+    } catch (...) {
+        f.scanning.store(false);
+    }
+}
+
+// ---- client side ---------------------------------------------------------------------------
+std::string now_stamp() {
+    SYSTEMTIME time;
+    GetLocalTime(&time);
+    return std::format("{:04}{:02}{:02}-{:02}{:02}{:02}", time.wYear, time.wMonth, time.wDay, time.wHour, time.wMinute, time.wSecond);
+}
+void open_csv(DarkFlip& f) {
+    if (f.steps_csv.is_open() || f.csv_failed) return;
+    try {
+        const auto directory = logging::status().directory;
+        if (directory.empty()) {
+            f.csv_failed = true;
+            logging::write(logging::Level::warning, logging::Channel::skater, "Dark Flip probe: no log folder; nothing will be recorded.");
+            return;
+        }
+        if (f.stamp.empty()) f.stamp = now_stamp();
+        const auto steps = directory / std::format("dark-flip-steps-{}.csv", f.stamp);
+        const auto states = directory / std::format("dark-flip-states-{}.csv", f.stamp);
+        f.steps_csv.open(steps, std::ios::binary | std::ios::trunc);
+        f.states_csv.open(states, std::ios::binary | std::ios::trunc);
+        if (!f.steps_csv || !f.states_csv) {
+            f.csv_failed = true;
+            logging::log(logging::Level::warning, logging::Channel::skater, "Dark Flip probe: could not write {}.", steps.string());
+            return;
+        }
+        f.steps_csv << "t,seq,mark,phase,state,step_ms,wipeout,pad_age_ms,buttons,A,B,X,Y,LB,RB,DU,DD,DL,DR,LT,RT,LX,LY,RX,RY,"
+                       "board_up_x,board_up_y,board_up_z,board_spin_x,board_spin_y,board_spin_z,"
+                       "rig_up_x,rig_up_y,rig_up_z,rig_spin_x,rig_spin_y,rig_spin_z,board_dot_rig,dark,"
+                       "state_changes,ctx_1380_to_143c,trick_state,anim_output\n";
+        f.states_csv << "t,seq,mark,phase,state,page,place,name,before,after\n";
+        f.csv_start = qpc_now();
+        logging::log(logging::Level::info, logging::Channel::skater, "Dark Flip probe: recording to {} and {}.", steps.string(), states.string());
+    } catch (...) {
+        f.csv_failed = true;
+    }
+}
+std::string hex(const std::uint8_t* bytes, std::size_t count) {
+    std::string text;
+    text.reserve(count * 2);
+    for (std::size_t i = 0; i < count; ++i) text += std::format("{:02x}", bytes[i]);
+    return text;
+}
+std::string decode(const Named& n, std::uint32_t word, std::uint16_t word_at) {
+    const int offset = static_cast<int>(n.place) - static_cast<int>(word_at);
+    if (n.kind == 'b' && offset >= 0 && offset < 4) return std::to_string((word >> (offset * 8)) & 0xff);
+    if ((n.kind == 'f' || n.kind == 'v') && (offset <= 0)) {
+        float value;
+        std::memcpy(&value, &word, 4);
+        return std::format("{:.4g}", value);
+    }
+    if (n.kind == 'i' && offset == 0) return std::to_string(word);
+    return std::format("0x{:08x}", word);
+}
+void write_changes(DarkFlip& f, const Row& r, const NameMap* names, double t) {
+    for (const auto& c : r.changes) {
+        bool named = false;
+        if (names) {
+            const auto& page = names->pages[c.page];
+            // States whose bytes overlap this word and whose bytes changed.
+            auto it = std::lower_bound(page.begin(), page.end(), static_cast<std::uint16_t>(c.word >= 16 ? c.word - 15 : 0),
+                                       [](const Named& n, std::uint16_t place) { return n.place < place; });
+            for (; it != page.end() && it->place < c.word + 4; ++it) {
+                const int first = std::max<int>(it->place, c.word) - c.word;
+                const int last = std::min<int>(it->place + it->size, c.word + 4) - c.word;
+                if (last <= first) continue;
+                bool changed = false;
+                for (int b = first; b < last; ++b)
+                    if (((c.before ^ c.after) >> (b * 8)) & 0xff) changed = true;
+                if (!changed) continue;
+                named = true;
+                f.states_csv << std::format("{:.4f},{},{},{},{},{},0x{:03x},{},{},{}\n", t, r.seq, r.mark, r.phase, r.state, static_cast<unsigned>(c.page), it->place,
+                                            it->name, decode(*it, c.before, c.word), decode(*it, c.after, c.word));
+            }
+        }
+        if (!named)
+            f.states_csv << std::format("{:.4f},{},{},{},{},{},0x{:03x},?,0x{:08x},0x{:08x}\n", t, r.seq, r.mark, r.phase, r.state, static_cast<unsigned>(c.page), c.word,
+                                        c.before, c.after);
+    }
+    if (r.changes_cut)
+        f.states_csv << std::format("{:.4f},{},{},{},{},,,(cut: {} more words changed),,\n", t, r.seq, r.mark, r.phase, r.state, r.changes_cut);
+}
+void write_row(DarkFlip& f, const Row& r, const NameMap* names) {
+    const auto& p = r.pad.values;
+    const double t = qpc_seconds(r.qpc - f.csv_start);
+    const double age = r.pad.qpc ? qpc_seconds(r.qpc - r.pad.qpc) * 1000.0 : -1.0;
+    std::string line = std::format("{:.4f},{},{},{},{},{:.2f},{},{:.1f},{:04x},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{},{}", t, r.seq, r.mark,
+                                   r.phase, r.state, r.seconds * 1000.0f, r.wipeout ? 1 : 0, age, p.buttons, (p.buttons & pad_a) ? 1 : 0,
+                                   (p.buttons & pad_b) ? 1 : 0, (p.buttons & pad_x) ? 1 : 0, (p.buttons & pad_y) ? 1 : 0,
+                                   (p.buttons & pad_lb) ? 1 : 0, (p.buttons & pad_rb) ? 1 : 0, (p.buttons & pad_up) ? 1 : 0,
+                                   (p.buttons & pad_down) ? 1 : 0, (p.buttons & pad_left) ? 1 : 0, (p.buttons & pad_right) ? 1 : 0,
+                                   static_cast<unsigned>(p.left_trigger), static_cast<unsigned>(p.right_trigger), p.left_x, p.left_y, p.right_x, p.right_y);
+    const auto three = [&](bool ok, const std::array<float, 3>& v) {
+        line += ok ? std::format(",{:.3f},{:.3f},{:.3f}", v[0], v[1], v[2]) : std::string(",,,");
+    };
+    three(r.board_ok, r.board_up);
+    three(r.board_ok, r.board_spin);
+    three(r.rig_ok, r.rig_up);
+    three(r.rig_ok, r.rig_spin);
+    if (r.board_ok && r.rig_ok) {
+        const float dot = r.board_up[0] * r.rig_up[0] + r.board_up[1] * r.rig_up[1] + r.board_up[2] * r.rig_up[2];
+        line += std::format(",{:.3f},{}", dot, dot < dark_dot ? 1 : 0);
+    } else {
+        line += ",,";
+    }
+    line += r.pages_ok ? std::format(",{}", r.changes.size() + r.changes_cut) : std::string(",");
+    line += ',';
+    if (r.context_ok)
+        for (std::size_t i = 0; i < context_words; ++i) line += std::format("{}{:08x}", i ? " " : "", r.context[i]);
+    line += ',';
+    // The trick state and its animation output only when they changed since the row before.
+    if (r.trick_ok && (!f.last_trick_ok || r.trick != f.last_trick)) {
+        line += hex(r.trick.data(), r.trick.size());
+        f.last_trick = r.trick;
+    }
+    f.last_trick_ok = r.trick_ok;
+    line += ',';
+    if (r.output_ok && (!f.last_output_ok || r.output != f.last_output)) {
+        line += hex(r.output.data(), r.output.size());
+        f.last_output = r.output;
+    }
+    f.last_output_ok = r.output_ok;
+    line += '\n';
+    f.steps_csv << line;
+    write_changes(f, r, names, t);
+}
+std::string mark_text(DarkFlip& f, std::uint32_t mark) {
+    std::lock_guard lock(f.marks_lock);
+    return mark < f.mark_texts.size() ? f.mark_texts[mark] : std::string{};
+}
+void log_air(DarkFlip& f, const AirSummary& a) {
+    const auto mark = mark_text(f, a.mark);
+    const auto step_text = [](std::int32_t step) { return step < 0 ? std::string("-") : std::to_string(step); };
+    logging::log(logging::Level::info, logging::Channel::skater,
+                 "Dark Flip probe: air {}{} ({:.2f} s, {} steps, state {} -> {}, landed into {}{}): dark {} step(s) from step {}; LT {} from {}, "
+                 "RT {} from {}, first grab while dark at step {}; RB {}, D-pad {}; left stick y {:+.2f}..{:+.2f}; body turned {:.0f} deg, "
+                 "skeleton up y min {:+.2f}; board.body min {:+.2f}.",
+                 a.seq, mark.empty() ? std::string{} : " [" + mark + "]", a.seconds, a.steps, a.first_state, a.last_state, a.after_state,
+                 a.wipeout ? ", wipeout" : "", a.dark_steps, step_text(a.first_dark), a.lt_steps, step_text(a.first_lt), a.rt_steps,
+                 step_text(a.first_rt), step_text(a.first_grab_while_dark), a.rb_steps, a.dpad_steps, a.left_y_min, a.left_y_max,
+                 a.body_turn_degrees, a.rig_up_y_min, a.board_dot_min);
+}
+void write_names(DarkFlip& f, const NameMap& names) {
+    try {
+        const auto directory = logging::status().directory;
+        if (directory.empty()) return;
+        if (f.stamp.empty()) f.stamp = now_stamp();
+        std::ofstream out(directory / std::format("dark-flip-names-{}.txt", f.stamp), std::ios::binary | std::ios::trunc);
+        out << std::format("# {} game state names found in {} ms ({} with two handles). page, place, kind, name\n", names.count, names.ms,
+                           names.conflicts);
+        for (std::size_t p = 0; p < page_count; ++p)
+            for (const auto& n : names.pages[p]) out << std::format("{}\t0x{:03x}\t{}\t{}\n", p, n.place, n.kind, n.name);
+    } catch (...) {
+    }
+}
+void flush_probe(DarkFlip& f) {
+    std::vector<Row> rows;
+    std::vector<AirSummary> airs;
+    {
+        std::lock_guard lock(f.queue_lock);
+        rows.swap(f.rows);
+        airs.swap(f.airs);
+    }
+    std::shared_ptr<const NameMap> names;
+    {
+        std::lock_guard lock(f.names_lock);
+        names = f.names;
+    }
+    if (!rows.empty()) {
+        open_csv(f);
+        if (f.steps_csv.is_open()) {
+            for (const auto& row : rows) write_row(f, row, names.get());
+            f.steps_csv.flush();
+            f.states_csv.flush();
+        }
+    }
+    for (const auto& a : airs) log_air(f, a);
+    if (const auto dropped = f.dropped.exchange(0, std::memory_order_relaxed))
+        logging::log(logging::Level::warning, logging::Channel::skater, "Dark Flip probe: {} row(s) dropped (the queue was full).", dropped);
+}
+bool set_probe(DarkFlip& f, bool on) {
+    if (on == f.probe_on.load(std::memory_order_acquire)) return true;
+    if (on) {
+        if (!no_bail_available() || !add_no_bail_step_listener(&on_step)) return false;
+        DingoSDKOverlaySetGamepadObserver(&observe_pad);
+        f.probe_on.store(true, std::memory_order_release);
+        logging::write(logging::Level::info, logging::Channel::skater, "Dark Flip probe on.");
+    } else {
+        f.probe_on.store(false, std::memory_order_release);
+        remove_no_bail_step_listener(&on_step);
+        DingoSDKOverlaySetGamepadObserver(nullptr);
+        logging::write(logging::Level::info, logging::Channel::skater, "Dark Flip probe off.");
+    }
+    return true;
+}
+std::string status_text(DarkFlip& f) {
+    if (!f.started.load(std::memory_order_acquire)) return "Dark Flip is unavailable.";
+    std::shared_ptr<const NameMap> names;
+    {
+        std::lock_guard lock(f.names_lock);
+        names = f.names;
+    }
+    const auto mark = mark_text(f, f.mark.load());
+    return std::format("Dark Flip {} (probe only, changes nothing in the game). Probe {}{}. Airs recorded: {}. State names: {}. Marker: {}.", version,
+                       f.probe_on.load() ? "ON" : "off",
+                       f.probe_on.load() ? " (logs\\dark-flip-*.csv)" : no_bail_available() ? "" : " (unavailable: No Bail's hooks did not start)",
+                       f.seq, f.scanning.load() ? std::string("searching...") : names ? std::format("{} found", names->count) : std::string("not searched yet"),
+                       mark.empty() ? std::string("none") : mark);
+}
+} // namespace
+
+bool start(std::uintptr_t image_base) noexcept {
+    auto& f = flip();
+    if (f.started.load(std::memory_order_acquire)) return true;
+    f.base.store(image_base, std::memory_order_release);
+    f.started.store(true, std::memory_order_release);
+    logging::log(logging::Level::info, logging::Channel::skater, "Dark Flip {} started (probe build: nothing in the game is changed).", version);
+    if (!set_probe(f, true))
+        logging::write(logging::Level::warning, logging::Channel::skater,
+                       "Dark Flip probe could not start: it follows the skater's physics steps through No Bail's hooks (not started, or no free step listener).");
+    return true;
+}
+
+void on_client_tick(std::uintptr_t) noexcept {
+    auto& f = flip();
+    if (!f.started.load(std::memory_order_acquire)) return;
+    try {
+        // The first air of the session asks for the names (the level's states are loaded by then).
+        bool have_names;
+        {
+            std::lock_guard lock(f.names_lock);
+            have_names = f.names != nullptr;
+        }
+        if (f.scan_wanted.exchange(false, std::memory_order_relaxed) && !have_names) start_scan(f);
+        static std::shared_ptr<const NameMap> written;
+        std::shared_ptr<const NameMap> names;
+        {
+            std::lock_guard lock(f.names_lock);
+            names = f.names;
+        }
+        if (names && names != written) {
+            written = names;
+            write_names(f, *names);
+            logging::log(logging::Level::info, logging::Channel::skater,
+                         "Dark Flip probe: found {} of the skater's game state names in {} ms ({} with two handles); logs\\dark-flip-names-*.txt.",
+                         names->count, names->ms, names->conflicts);
+        }
+        flush_probe(f);
+        static std::uint64_t said{};
+        if (const auto missing = f.block_missing.exchange(0, std::memory_order_relaxed); missing && f.probe_on.load() && GetTickCount64() > said) {
+            said = GetTickCount64() + 30000;
+            logging::log(logging::Level::warning, logging::Channel::skater,
+                         "Dark Flip probe: the skater's animation state pages were not found on {} step(s); the state diffs are missing.", missing);
+        }
+    } catch (...) {
+    }
+}
+
+std::string command(const std::vector<std::string>& words) {
+    auto& f = flip();
+    const auto verb = words.empty() ? std::string("status") : words[0];
+    if (verb == "status" || verb.empty()) return status_text(f);
+    if (!f.started.load()) return status_text(f);
+    if (verb == "probe") {
+        const auto arg = words.size() > 1 ? words[1] : std::string{};
+        if (arg != "on" && arg != "off") return "Usage: darkflip probe on|off";
+        if (!set_probe(f, arg == "on")) return "The probe could not start: No Bail's hooks did not start, or no step listener is free.";
+        return status_text(f);
+    }
+    if (verb == "mark") {
+        std::string text;
+        for (std::size_t i = 1; i < words.size(); ++i) text += (i > 1 ? " " : "") + words[i];
+        std::uint32_t index;
+        {
+            std::lock_guard lock(f.marks_lock);
+            f.mark_texts.push_back(text);
+            index = static_cast<std::uint32_t>(f.mark_texts.size() - 1);
+        }
+        f.mark.store(index, std::memory_order_relaxed);
+        logging::log(logging::Level::info, logging::Channel::skater, "Dark Flip probe: marker {} \"{}\" from air {} on.", index, text, f.seq + 1);
+        return std::format("Marker {} \"{}\": the next airs are tagged with it.", index, text);
+    }
+    if (verb == "names") {
+        start_scan(f);
+        return "Searching the game's memory for the skater's game state names (a few seconds; ReSkate.log says when it is done).";
+    }
+    return "Usage: darkflip status | darkflip probe on|off | darkflip mark <text> | darkflip names";
+}
+} // namespace dingosdk::dark_flip
